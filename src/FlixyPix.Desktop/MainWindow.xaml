<Window x:Class="FlixyPix.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:FlixyPix.Desktop" Title="FlixyPix" Width="1440" Height="940" MinWidth="760" MinHeight="720" Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource Text}" FontFamily="Segoe UI" FontSize="14" AllowDrop="True" Drop="OnDrop" PreviewKeyDown="OnKeyDown">
 <Grid x:Name="RootContent" Background="{DynamicResource WindowBackground}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <!-- Header: brand, global search, actions -->
  <Border Background="{DynamicResource ChromeBackground}" BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1" Padding="20,12">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="SidebarToggle" Content="&#xE700;" Click="ToggleSidebarClicked" Style="{StaticResource IconButton}" Margin="-8,0,10,0" ToolTip="{local:T 'Show or hide the sidebar (Ctrl+B)'}" AutomationProperties.Name="{local:T 'Show or hide the sidebar'}"/><Image Source="/Assets/flixypix-mark-96.png" Width="40" Height="40" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality" ToolTip="FlixyPix" AutomationProperties.Name="FlixyPix"/><StackPanel VerticalAlignment="Center"><TextBlock Text="FlixyPix" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{local:T 'YOUR MEDIA. YOUR ARCHIVE.'}" FontSize="9.5" Foreground="{DynamicResource Muted}"/></StackPanel></StackPanel>
    <Grid Grid.Column="1" MaxWidth="640" Margin="32,0" VerticalAlignment="Center">
     <TextBox x:Name="SearchBox" TextChanged="SearchChanged" KeyDown="SearchKeyDown" Margin="0" Padding="34,8,34,8" ToolTip="{local:T 'Search titles, file paths and tags (Ctrl+F). Enter turns #tag, -#tag, ★4 and type:video into filters.'}" AutomationProperties.Name="{local:T 'Search items'}"/>
     <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="14" Foreground="{DynamicResource Muted}" Margin="12,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False"/>
     <TextBlock Text="{local:T 'Search titles, tags or file paths'}" IsHitTestVisible="False" Foreground="{DynamicResource Subtle}" VerticalAlignment="Center" Margin="35,0,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
     <Button Content="&#xE711;" Click="ClearSearch" HorizontalAlignment="Right" Margin="0,0,4,0" Padding="7" FontSize="11" ToolTip="{local:T 'Clear search (Esc)'}" AutomationProperties.Name="{local:T 'Clear search'}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource IconButton}"><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
    </Grid>
    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
     <Button Click="AddMenu" Style="{StaticResource Primary}" Margin="0,0,10,0" ToolTip="{local:T 'Import files, folders or archives (Ctrl+O: files)'}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/><TextBlock Text="{local:T 'Add'}"/><TextBlock Text="&#xE70D;" Style="{StaticResource Icon}" FontSize="9" Margin="8,1,0,0"/></StackPanel></Button>
     <Button Content="&#xE9D5;" Click="QueueClicked" Style="{StaticResource IconButton}" ToolTip="{local:T 'Media jobs'}" AutomationProperties.Name="{local:T 'Media jobs'}"/>
     <Button Content="&#xE8CB;" Click="OrganizeMenu" Style="{StaticResource IconButton}" ToolTip="{local:T 'Organize: searches, rules, vocabulary, duplicates'}" AutomationProperties.Name="{local:T 'Organize'}"/>
     <Button Content="&#xE8F1;" Click="CatalogMenu" Style="{StaticResource IconButton}" ToolTip="{local:T 'Catalog: backup, export, import, encryption'}" AutomationProperties.Name="{local:T 'Catalog'}"/>
     <Button Content="&#xE713;" Click="Settings" Style="{StaticResource IconButton}" ToolTip="{local:T 'Settings'}" AutomationProperties.Name="{local:T 'Settings'}"/>
    </StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="232"/><ColumnDefinition Width="*"/><ColumnDefinition x:Name="DetailsColumn" Width="336"/></Grid.ColumnDefinitions>
   <!-- Sidebar -->
   <Border x:Name="Sidebar" Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource DividerSoft}" BorderThickness="0,0,1,0" Padding="12,18,8,12"><ScrollViewer VerticalScrollBarVisibility="Auto"><DockPanel Margin="0,0,6,0">
    <StackPanel DockPanel.Dock="Top">
     <DockPanel Margin="10,0,0,8"><Button DockPanel.Dock="Right" Content="&#xE76B;" Click="ToggleSidebarClicked" Style="{StaticResource IconButton}" Padding="6" FontSize="11" ToolTip="{local:T 'Fold the sidebar (Ctrl+B)'}" AutomationProperties.Name="{local:T 'Fold the sidebar'}"/><Button DockPanel.Dock="Right" Content="&#xE8AB;" Style="{StaticResource IconButton}" Padding="6" FontSize="11" Click="ManageLibraries" ToolTip="{local:T 'Manage and switch libraries (Ctrl+Shift+B)'}" AutomationProperties.Name="{local:T 'Libraries'}"/><TextBlock x:Name="LibraryHeader" Text="{local:T 'LIBRARY'}" Style="{StaticResource Section}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></DockPanel>
     <StackPanel x:Name="NavItems">
      <RadioButton Style="{StaticResource Nav}" GroupName="nav" Tag="home" Click="Navigate" ToolTip="{local:T 'Home page (Ctrl+Home)'}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" Style="{StaticResource NavIcon}"/><TextBlock Text="{local:T 'Home'}"/></StackPanel></RadioButton>
      <RadioButton Style="{StaticResource Nav}" GroupName="nav" Tag="all" Click="Navigate" IsChecked="True"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xF0E2;" Style="{StaticResource NavIcon}"/><TextBlock Text="{local:T 'All items'}"/></StackPanel></RadioButton>
      <RadioButton Style="{StaticResource Nav}" GroupName="nav" Tag="Video" Click="Navigate"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE714;" Style="{StaticResource NavIcon}"/><TextBlock Text="{local:T 'Videos'}"/></StackPanel></RadioButton>
      <RadioButton Style="{StaticResource Nav}" GroupName="nav" Tag="Image" Click="Navigate"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE91B;" Style="{StaticResource NavIcon}"/><TextBlock Text="{local:T 'Images'}"/></StackPanel></RadioButton>
      <RadioButton Style="{StaticResource Nav}" GroupName="nav" Tag="Audio" Click="Navigate"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8D6;" Style="{StaticResource NavIcon}"/><TextBlock Text="{local:T 'Audio'}"/></StackPanel></RadioButton>
      <RadioButton Style="{StaticResource Nav}" GroupName="nav" Tag="favorites" Click="Navigate"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xEB51;" Style="{StaticResource NavIcon}"/><TextBlock Text="{local:T 'Favorites'}"/></StackPanel></RadioButton>
      <RadioButton Style="{StaticResource Nav}" GroupName="nav" Tag="watchlater" Click="Navigate"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE823;" Style="{StaticResource NavIcon}"/><TextBlock Text="{local:T 'Watch later'}"/></StackPanel></RadioButton>
     </StackPanel>
     <DockPanel x:Name="CollectionsHeader" Margin="10,20,0,6"><Button DockPanel.Dock="Right" Content="&#xE710;" Style="{StaticResource IconButton}" Padding="6" FontSize="11" Click="NewPlaylist" ToolTip="{local:T 'New collection, smart collection, slideshow or collection set'}" AutomationProperties.Name="{local:T 'Create collection'}"/><TextBlock Text="{local:T 'COLLECTIONS'}" Style="{StaticResource Section}"/></DockPanel>
     <TreeView x:Name="CollectionTree" MaxHeight="420" AllowDrop="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled" PreviewMouseLeftButtonDown="CollectionTreeMouseDown" PreviewMouseMove="CollectionTreeMouseMove" PreviewMouseLeftButtonUp="CollectionTreeClicked" MouseRightButtonUp="CollectionTreeRightClicked" DragOver="CollectionTreeDragOver" Drop="CollectionTreeDrop" KeyDown="CollectionTreeKeyDown" AutomationProperties.Name="{local:T 'Collections'}" ToolTip="{local:T 'Click: open · drag items onto a collection: add · drag collections onto a set: move · right-click: more · B: add to the target collection'}">
      <TreeView.ItemContainerStyle><Style TargetType="TreeViewItem"><Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/><Setter Property="Padding" Value="1,0"/><Setter Property="Foreground" Value="{DynamicResource TextSoft}"/></Style></TreeView.ItemContainerStyle>
      <TreeView.ItemTemplate><HierarchicalDataTemplate ItemsSource="{Binding Children}"><DockPanel Margin="1,3" ToolTip="{Binding Hint}"><TextBlock Text="{Binding Glyph}" Style="{StaticResource NavIcon}" FontSize="12" DockPanel.Dock="Left"/><TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="10" Foreground="{DynamicResource Accent}" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="4,0,2,0" Visibility="{Binding TargetVisibility}" ToolTip="{local:T 'Target collection: B adds items here'}"/><TextBlock Text="{Binding CountLabel}" DockPanel.Dock="Right" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="6,0,2,0" Typography.NumeralAlignment="Tabular"/><Border DockPanel.Dock="Right" Visibility="{Binding NewVisibility}" Background="{DynamicResource Accent}" CornerRadius="7" Padding="5,0" Margin="6,0,0,0" VerticalAlignment="Center" ToolTip="{local:T 'Newly imported since last opened'}"><TextBlock Text="{Binding NewLabel}" Foreground="White" FontSize="10"/></Border><TextBlock Text="{Binding Name}" Tag="title" FontWeight="{Binding Weight}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" MaxWidth="{Binding NameWidth}"/></DockPanel></HierarchicalDataTemplate></TreeView.ItemTemplate>
     </TreeView>
     <TextBlock x:Name="SavedSearchHint" Text="{local:T 'Any search can become a smart collection: set up search and filters, then ＋ → Smart collection. It stays current, new matching items appear in it by themselves.'}" FontSize="11" Foreground="{DynamicResource Subtle}" TextWrapping="Wrap" Margin="10,4,4,4"/>
     <DockPanel x:Name="TagsHeader" Margin="10,18,0,6"><Button DockPanel.Dock="Right" Content="&#xE8F1;" Click="DirectoryClicked" Style="{StaticResource IconButton}" Padding="5" FontSize="12" ToolTip="{local:T 'Directory: manage tags, performers and studios'}" AutomationProperties.Name="{local:T 'Open directory'}"/><Button x:Name="TagSortButton" DockPanel.Dock="Right" Content="{local:T 'Frequency'}" Click="TagSortClicked" Style="{StaticResource Quiet}" Padding="6,2" FontSize="11" ToolTip="{local:T 'Sort tags by frequency or name'}"/><TextBlock Text="{local:T 'TAGS'}" Style="{StaticResource Section}"/></DockPanel>
     <Grid><TextBox x:Name="TagFilterBox" TextChanged="TagFilterChanged" Margin="0,0,0,6" Padding="28,5,7,5" FontSize="12" AutomationProperties.Name="{local:T 'Filter tags'}"/><TextBlock Text="&#xE71C;" Style="{StaticResource Icon}" FontSize="11" Foreground="{DynamicResource Muted}" Margin="10,0,0,6" HorizontalAlignment="Left" IsHitTestVisible="False"/><TextBlock Text="{local:T 'Filter tags'}" IsHitTestVisible="False" Foreground="{DynamicResource Subtle}" FontSize="12" VerticalAlignment="Center" Margin="29,0,0,6"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=TagFilterBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
     <CheckBox x:Name="ShowUnusedTags" Content="{local:T 'Unused tags too'}" FontSize="11" Foreground="{DynamicResource Muted}" Checked="TagListOptionsChanged" Unchecked="TagListOptionsChanged" Margin="4,0,0,6" ToolTip="{local:T 'Show vocabulary tags without assigned items'}"/>
     <ListBox x:Name="Tags" MaxHeight="300" VirtualizingPanel.IsVirtualizing="True" ScrollViewer.CanContentScroll="True" ToolTip="{local:T 'Click: filter · Ctrl+click: exclude · right-click: more actions · drag items here: assign tag'}">
      <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="Margin" Value="0,0,4,1"/><Setter Property="AllowDrop" Value="True"/><EventSetter Event="PreviewMouseLeftButtonUp" Handler="TagItemClicked"/><EventSetter Event="MouseRightButtonUp" Handler="TagItemRightClicked"/><EventSetter Event="DragOver" Handler="TagItemDragOver"/><EventSetter Event="Drop" Handler="TagItemDrop"/></Style></ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate><DataTemplate><Grid Margin="4,1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" Foreground="{Binding Foreground}" ToolTip="{Binding Tag}"/><TextBlock Grid.Column="1" Text="{Binding CountLabel}" Foreground="{DynamicResource Subtle}" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center"/></Grid></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <TextBlock Text="{local:T 'TAG CATEGORIES'}" Style="{StaticResource Section}" Margin="10,18,0,6"/><TreeView x:Name="CategorizedTags" SelectedItemChanged="CategorizedTagSelected" MaxHeight="180"/>
     <TextBlock x:Name="FoldersHeader" Text="{local:T 'FOLDERS'}" Style="{StaticResource Section}" Margin="10,18,0,6"/><TreeView x:Name="Folders" SelectedItemChanged="FolderSelected" MaxHeight="230"/>
    </StackPanel>
    <TextBlock DockPanel.Dock="Bottom" VerticalAlignment="Bottom" Text="{local:T 'Stored locally.
Kept for the future.'}" Foreground="{DynamicResource Subtle}" FontSize="11" Margin="10,20,0,0"/>
   </DockPanel></ScrollViewer></Border>
    <Border x:Name="SidebarRail" Visibility="Collapsed" Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource DividerSoft}" BorderThickness="0,0,1,0" Padding="0,12,0,0"><StackPanel HorizontalAlignment="Center">
     <Button Content="&#xE76C;" Click="ToggleSidebarClicked" Style="{StaticResource IconButton}" ToolTip="{local:T 'Unfold the sidebar (Ctrl+B)'}" AutomationProperties.Name="{local:T 'Unfold the sidebar'}"/>
     <Border Height="1" Width="24" Margin="0,6" Background="{DynamicResource Divider}"/>
     <Button Content="&#xE80F;" Tag="library" Click="SidebarRailClicked" Style="{StaticResource IconButton}" Margin="0,2" ToolTip="{local:T 'Library'}" AutomationProperties.Name="{local:T 'Library'}"/>
     <Button Content="&#xE8FD;" Tag="collections" Click="SidebarRailClicked" Style="{StaticResource IconButton}" Margin="0,2" ToolTip="{local:T 'Collections'}" AutomationProperties.Name="{local:T 'Collections'}"/>
     <Button Content="&#xE8EC;" Tag="tags" Click="SidebarRailClicked" Style="{StaticResource IconButton}" Margin="0,2" ToolTip="{local:T 'Tags'}" AutomationProperties.Name="{local:T 'Tags'}"/>
     <Button Content="&#xE8B7;" Tag="folders" Click="SidebarRailClicked" Style="{StaticResource IconButton}" Margin="0,2" ToolTip="{local:T 'Folders'}" AutomationProperties.Name="{local:T 'Folders'}"/>
    </StackPanel></Border>
    <Thumb x:Name="SidebarResizer" HorizontalAlignment="Right" Width="6" Margin="0,0,-3,0" Cursor="SizeWE" Panel.ZIndex="5" DragDelta="SidebarResizing" DragCompleted="PaneResized" ToolTip="{local:T 'Drag to change the width'}"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="Transparent"/></ControlTemplate></Thumb.Template></Thumb>
   <!-- Media -->
   <Grid x:Name="MediaPane" Grid.Column="1" Margin="24,20,20,8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,14">
     <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
      <Button x:Name="CollectionActions" Click="CollectionMenu" Visibility="Collapsed" Margin="0,0,10,0"><StackPanel Orientation="Horizontal"><TextBlock Text="{local:T 'Collection'}"/><TextBlock Text="&#xE70D;" Style="{StaticResource Icon}" FontSize="9" Margin="8,1,0,0"/></StackPanel></Button>
     </StackPanel>
     <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Top" Margin="-10,4,8,0"><Button x:Name="BackButton" Content="&#xE72B;" Click="BackClicked" Style="{StaticResource IconButton}" IsEnabled="False" ToolTip="{local:T 'Back (Alt+←, mouse button 4)'}" AutomationProperties.Name="{local:T 'Back'}"/><Button x:Name="ForwardButton" Content="&#xE72A;" Click="ForwardClicked" Style="{StaticResource IconButton}" IsEnabled="False" ToolTip="{local:T 'Forward (Alt+→, mouse button 5)'}" AutomationProperties.Name="{local:T 'Forward'}"/></StackPanel>
     <StackPanel><TextBlock x:Name="ViewTitle" Text="{local:T 'All items'}" FontFamily="{StaticResource DisplayFont}" FontSize="28" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="CountLabel" Text="{local:T 'Your library is waiting for its first import'}" Foreground="{DynamicResource Muted}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
    </DockPanel>
    <DockPanel Grid.Row="1" Margin="0,0,0,8">
     <Button x:Name="FilterButton" DockPanel.Dock="Left" Click="FilterButtonClicked" VerticalAlignment="Top" Margin="0,0,10,6" Padding="11,6" FontSize="12" ToolTip="{local:T 'All filters: rating, type, category, performers, studios, tags, duration, dates and more'}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE71C;" Style="{StaticResource Icon}" FontSize="12" Margin="0,1,7,0"/><TextBlock x:Name="FilterButtonText" Text="{local:T 'Filter'}"/></StackPanel></Button>
     <Button x:Name="ViewButton" DockPanel.Dock="Right" Click="ViewMenuClicked" VerticalAlignment="Top" Margin="10,0,0,6" Padding="11,6" FontSize="12" ToolTip="{local:T 'Appearance, tile size and sorting'}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xF0E2;" Style="{StaticResource Icon}" FontSize="12" Margin="0,1,7,0"/><TextBlock x:Name="ViewButtonText"/><TextBlock Text="&#xE70D;" Style="{StaticResource Icon}" FontSize="9" Margin="8,1,0,0"/></StackPanel></Button>
     <StackPanel x:Name="FilterBackingControls" DockPanel.Dock="Left" Visibility="Collapsed">
      <ComboBox x:Name="RatingFilter" SelectedIndex="0" SelectionChanged="FilterChanged" ToolTip="{local:T 'Minimum rating'}"><ComboBoxItem Content="{local:T 'All ratings'}"/><ComboBoxItem Content="{local:T '★ and up'}"/><ComboBoxItem Content="{local:T '★★ and up'}"/><ComboBoxItem Content="{local:T '★★★ and up'}"/><ComboBoxItem Content="{local:T '★★★★ and up'}"/><ComboBoxItem Content="★★★★★"/></ComboBox>
      <ComboBox x:Name="CategoryFilter" SelectionChanged="CategoryChanged" ToolTip="{local:T 'Media category'}"/>
     </StackPanel>
     <WrapPanel x:Name="ActiveTagFilters" VerticalAlignment="Center"/>
    </DockPanel>
    <Popup x:Name="ViewPopup" Grid.Row="1" PlacementTarget="{Binding ElementName=ViewButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
     <Border x:Name="ViewPopupFrame" Margin="0,4,12,12" Padding="16,14" CornerRadius="10" BorderThickness="1" Background="{DynamicResource PopupBackground}" BorderBrush="{DynamicResource PopupBorder}" Width="260"><StackPanel>
      <TextBlock Text="{local:T 'Appearance'}" Style="{StaticResource Section}" Margin="0,0,0,6"/>
      <ListBox x:Name="ViewChoice" HorizontalAlignment="Left" Style="{StaticResource SegmentList}" SelectedIndex="0" SelectionChanged="ViewChanged" VerticalAlignment="Center" AutomationProperties.Name="{local:T 'Appearance'}">
       <ListBoxItem ToolTip="{local:T 'Tiles'}" AutomationProperties.Name="{local:T 'Tiles'}"><TextBlock Text="&#xF0E2;" Style="{StaticResource Icon}" FontSize="13"/></ListBoxItem>
       <ListBoxItem ToolTip="{local:T 'List'}" AutomationProperties.Name="{local:T 'List'}"><TextBlock Text="&#xE8FD;" Style="{StaticResource Icon}" FontSize="13"/></ListBoxItem>
       <ListBoxItem ToolTip="{local:T 'Video wall: the preview clips in view play by themselves'}" AutomationProperties.Name="{local:T 'Video wall'}"><TextBlock Text="&#xE8B2;" Style="{StaticResource Icon}" FontSize="13"/></ListBoxItem>
      </ListBox>
      <StackPanel x:Name="TileSizePanel" Orientation="Horizontal" Margin="0,14,0,0" VerticalAlignment="Center" ToolTip="{local:T 'Tile size'}"><TextBlock Text="&#xE71E;" Style="{StaticResource Icon}" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,0,6,0"/><Slider x:Name="TileSize" Width="190" Minimum="140" Maximum="480" ValueChanged="TileSizeChanged" LostMouseCapture="TileSizeCommitted" AutomationProperties.Name="{local:T 'Tile size'}"/></StackPanel>
      <TextBlock Text="{local:T 'Sorting'}" Style="{StaticResource Section}" Margin="0,14,0,6"/>
      <ComboBox x:Name="SortChoice" SelectedIndex="0" SelectionChanged="SortChanged" ToolTip="{local:T 'Sorting'}"><ComboBoxItem Content="{local:T 'Title A–Z'}"/><ComboBoxItem Content="{local:T 'Title Z–A'}"/><ComboBoxItem Content="{local:T 'Newest first'}"/><ComboBoxItem Content="{local:T 'Longest first'}"/><ComboBoxItem Content="{local:T 'Best rated'}"/><ComboBoxItem Content="{local:T 'Collection order'}"/><ComboBoxItem Content="{local:T 'Oldest files first'}"/><ComboBoxItem Content="{local:T 'Newest files first'}"/><ComboBoxItem Content="{local:T 'Highest O counter'}"/><ComboBoxItem Content="{local:T 'Highest resolution'}"/><ComboBoxItem Content="{local:T 'Highest bit rate'}"/></ComboBox>
     </StackPanel></Border>
    </Popup>
    <Popup x:Name="FilterFlyout" Grid.Row="1" PlacementTarget="{Binding ElementName=FilterButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
     <Border x:Name="FilterFlyoutFrame" Width="640" Margin="0,4,12,12" Padding="14" CornerRadius="10" BorderThickness="1" Background="{DynamicResource PopupBackground}" BorderBrush="{DynamicResource PopupBorder}"><DockPanel>
      <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
       <TextBlock Text="{local:T 'Any search can become a smart collection. It keeps the search text and all filters and stays current: new matching items appear in it by themselves. You find it on the left under “Collections”.'}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource Subtle}" DockPanel.Dock="Top" Margin="2,0,0,10"/>
       <Button DockPanel.Dock="Right" Content="{local:T 'Done'}" Click="FilterFlyoutDone" Style="{StaticResource Primary}" Margin="8,0,0,0" VerticalAlignment="Center"/>
       <Button DockPanel.Dock="Right" Content="{local:T 'Save as smart collection …'}" Click="SaveSearchClicked" Margin="8,0,0,0" VerticalAlignment="Center"/>
       <Button DockPanel.Dock="Left" Content="{local:T 'Remove all filters'}" Click="ResetFiltersClicked" Style="{StaticResource Quiet}" VerticalAlignment="Center"/>
      </DockPanel>
      <ScrollViewer DockPanel.Dock="Left" Width="220" Margin="0,0,16,0" MaxHeight="440" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="FilterBar"/></ScrollViewer>
      <Border x:Name="FilterSectionHost" MinHeight="300" HorizontalAlignment="Stretch"/>
     </DockPanel></Border>
    </Popup>
    <StackPanel Grid.Row="2">
     <Border x:Name="FolderBanner" Visibility="Collapsed" Background="{DynamicResource Chip}" BorderBrush="{DynamicResource SelectionBorder}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
      <DockPanel>
       <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
        <Button Content="{local:T 'Apply'}" Click="FolderBannerApply" Style="{StaticResource Primary}" Margin="8,0,0,0" ToolTip="{local:T 'Add new files and reassign moved ones'}"/>
        <Button Content="{local:T 'View …'}" Click="FolderBannerReview" Margin="8,0,0,0" ToolTip="{local:T 'Choose changes individually'}"/>
        <Button Content="&#xE711;" Click="FolderBannerDismiss" Style="{StaticResource IconButton}" Padding="7" FontSize="11" Margin="4,0,0,0" ToolTip="{local:T 'Later'}" AutomationProperties.Name="{local:T 'Close note'}"/>
       </StackPanel>
       <TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" FontSize="16" Foreground="{DynamicResource TagIncluded}" VerticalAlignment="Center" Margin="0,0,10,0"/>
       <TextBlock x:Name="FolderBannerText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
      </DockPanel>
     </Border>
    </StackPanel>
    <Grid Grid.Row="3"><ListBox x:Name="MediaList" SelectionMode="Extended" MouseRightButtonUp="MediaRightClicked" PreviewMouseLeftButtonDown="MediaListMouseDown" PreviewMouseMove="MediaListMouseMove" PreviewMouseLeftButtonUp="MediaListMouseUp" SelectionChanged="MediaSelected" MouseDoubleClick="MediaDoubleClick" ScrollViewer.VerticalScrollBarVisibility="Auto"><ListBox.ItemsPanel><ItemsPanelTemplate><local:VirtualizingTilePanel/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="local:Motion.HoverLift" Value="True"/></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate>
      <Border Background="{DynamicResource CardBackground}" CornerRadius="10" Padding="7">
       <StackPanel>
        <local:AspectBox Ratio="0.6"><Grid Background="{DynamicResource MediaBackground}" local:RoundedClip.Radius="6" local:Privacy.Blur="True">
         <TextBlock Text="{Binding Icon}" Style="{StaticResource Icon}" FontSize="30" Foreground="{DynamicResource IconMuted}" HorizontalAlignment="Center"/>
         <Image x:Name="thumbnail" Source="{Binding Thumbnail, NotifyOnTargetUpdated=True}" Stretch="UniformToFill" local:Motion.FadeIn="True"/>
         <Image Source="{Binding PreviewFrame}" Stretch="UniformToFill"/>
         <local:LoopingClip Source="{Binding PreviewClip}"/>
         <ItemsControl ItemsSource="{Binding Badges}" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="3,3,0,0" Focusable="False" IsHitTestVisible="False"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource BadgeFrame}" Margin="3"><TextBlock Text="{Binding}"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
         <Border Style="{StaticResource BadgeFrame}" VerticalAlignment="Top" HorizontalAlignment="Right" Background="#C62828" Visibility="{Binding MissingVisibility}" ToolTip="{local:T 'File currently unavailable · reassign under Tools'}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontWeight="Normal" Margin="0,1.5,4,0"/><TextBlock Text="{local:T 'Missing'}"/></StackPanel></Border>
         <Border Style="{StaticResource BadgeFrame}" VerticalAlignment="Bottom" HorizontalAlignment="Left" ToolTip="{Binding KindLabel}"><TextBlock Text="{Binding Icon}" FontFamily="{StaticResource IconFont}" FontWeight="Normal" Margin="0,1.5"/></Border>
         <Border VerticalAlignment="Bottom" Height="3" Background="#73000000" Visibility="{Binding TileProgressVisibility}" ToolTip="{Binding ProgressLabel}"><Border Background="{DynamicResource Accent}" RenderTransformOrigin="0,0.5"><Border.RenderTransform><ScaleTransform ScaleX="{Binding Progress}"/></Border.RenderTransform></Border></Border>
